{
  "name": "eli-apply-mate",
  "version": "0.2.0",
  "private": true,
  "description": "A local personal Chrome extension for cautious job application autofill.",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && vite build && node scripts/build-extension.mjs",
    "test": "vitest run",
    "serve:test": "vite test-pages --host 127.0.0.1 --port 5174"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.6.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "esbuild": "^0.20.2",
    "jsdom": "^24.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^1.4.0"
  }
}
