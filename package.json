{
  "name": "eli-apply-mate",
  "version": "0.3.0",
  "private": true,
  "description": "A local personal Chrome extension for cautious job application autofill.",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "clean": "rimraf dist",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && vite build && node scripts/build-extension.mjs",
    "test": "vitest run",
    "verify:extension": "node scripts/verify-extension.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "serve:test": "vite test-pages --host 127.0.0.1 --port 5174"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.0.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
